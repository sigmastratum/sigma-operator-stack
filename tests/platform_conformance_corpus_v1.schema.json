    "case_id_identity_changes_after_preview": {"$ref": "#/$defs/case_with_id_identity_changes_after_preview"},
    "case_id_repository_lock_deadline": {"$ref": "#/$defs/case_with_id_repository_lock_deadline"},
    "case_id_valid_staging_journal_after_crash": {"$ref": "#/$defs/case_with_id_valid_staging_journal_after_crash"},
    "case_id_invalid_staging_journal_after_crash": {"$ref": "#/$defs/case_with_id_invalid_staging_journal_after_crash"},
    "case_id_same_version_rerun": {"$ref": "#/$defs/case_with_id_same_version_rerun"},
    "case_id_compatible_package_rebind": {"$ref": "#/$defs/case_with_id_compatible_package_rebind"},
    "case_id_setup_remove_preserves_workspace": {"$ref": "#/$defs/case_with_id_setup_remove_preserves_workspace"},
    "case_id_forged_or_replayed_receipt": {"$ref": "#/$defs/case_with_id_forged_or_replayed_receipt"},
    "case_id_valid_receipt_for_stale_source": {"$ref": "#/$defs/case_with_id_valid_receipt_for_stale_source"},
    "case_id_codex_missing": {"$ref": "#/$defs/case_with_id_codex_missing"},
    "case_id_codex_auth_missing": {"$ref": "#/$defs/case_with_id_codex_auth_missing"},
    "case_id_exact_eight_tools": {"$ref": "#/$defs/case_with_id_exact_eight_tools"},
    "case_id_unknown_or_mutating_tool": {"$ref": "#/$defs/case_with_id_unknown_or_mutating_tool"},
    "case_id_executable_project_check": {"allOf": [{"$ref": "#/$defs/case"}, {"$ref": "#/$defs/case_with_id_executable_project_check"}]},
    "case_with_id_clean_current_repository": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "clean_current_repository"}}},
    "case_with_id_source_status_changed": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "source_status_changed"}}},
    "case_with_id_compatible_foreign_surfaces_preserved": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "compatible_foreign_surfaces_preserved"}}},
    "case_with_id_foreign_sigma_blocks": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "foreign_sigma_blocks"}}},
    "case_with_id_ignored_exact_managed_bytes": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "ignored_exact_managed_bytes"}}},
    "case_with_id_ignored_managed_bytes_drift": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "ignored_managed_bytes_drift"}}},
    "case_with_id_multiple_authorities_unselected": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "multiple_authorities_unselected"}}},
    "case_with_id_multiple_authorities_explicit_selection": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "multiple_authorities_explicit_selection"}}},
    "case_with_id_lookup_key_collision": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "lookup_key_collision"}}},
    "case_with_id_non_utf8_git_path": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "non_utf8_git_path"}}},
    "case_with_id_windows_reserved_or_ads_path": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "windows_reserved_or_ads_path"}}},
    "case_with_id_managed_ancestry_indirection": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "managed_ancestry_indirection"}}},
