    "case_with_id_setup_remove_preserves_workspace": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "setup_remove_preserves_workspace"}}},
    "case_with_id_forged_or_replayed_receipt": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "forged_or_replayed_receipt"}}},
    "case_with_id_valid_receipt_for_stale_source": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "valid_receipt_for_stale_source"}}},
    "case_with_id_codex_missing": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "codex_missing"}}},
    "case_with_id_codex_auth_missing": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "codex_auth_missing"}}},
    "case_with_id_exact_eight_tools": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"const": "exact_eight_tools"}}},
