{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sigma-stratum.dev/sos/sos-managed-file-batch-projection-v1.schema.json",
  "title": "SOS Managed File Batch Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "batch_id", "repository_id", "batch_digest", "state", "recovery_required", "step_count", "not_started_count", "applied_count", "rolled_back_count", "in_progress_count", "reasons", "steps", "raw_content_serialized", "absolute_paths_serialized"],
  "properties": {
    "contract": {"const": "sos_managed_file_batch_projection_v1"},
    "batch_id": {"$ref": "#/$defs/id"},
    "repository_id": {"$ref": "#/$defs/digest"},
    "batch_digest": {"$ref": "#/$defs/digest"},
    "state": {"enum": ["not_started", "integrated", "rolled_back", "integration_incomplete"]},
    "recovery_required": {"type": "boolean"},
    "step_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "not_started_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "applied_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "rolled_back_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "in_progress_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "SOS_MANAGED_FILE_BATCH_NOT_STARTED",
          "SOS_MANAGED_FILE_BATCH_INTEGRATED",
          "SOS_MANAGED_FILE_BATCH_ROLLED_BACK",
          "SOS_MANAGED_FILE_BATCH_INTEGRATION_INCOMPLETE"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/step"}
    },
    "raw_content_serialized": {"const": false},
    "absolute_paths_serialized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "integration_incomplete"}}, "required": ["state"]},
      "then": {"properties": {"recovery_required": {"const": true}}},
      "else": {"properties": {"recovery_required": {"const": false}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_ordinal", "journal_id", "plan_digest", "state"],
      "properties": {
        "sequence_ordinal": {"type": "integer", "minimum": 1, "maximum": 32},
        "journal_id": {"$ref": "#/$defs/id"},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "state": {"enum": ["not_started", "apply_prepared", "applied", "rollback_prepared", "rolled_back"]}
      }
    }
  }
}
