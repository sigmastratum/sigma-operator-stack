{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sigma-stratum.dev/sos/sos-managed-file-batch-v1.schema.json",
  "title": "SOS Managed File Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "batch_id", "repository_id", "step_count", "steps", "raw_content_serialized", "absolute_paths_serialized", "batch_digest"],
  "properties": {
    "contract": {"const": "sos_managed_file_batch_v1"},
    "batch_id": {"$ref": "#/$defs/id"},
    "repository_id": {"$ref": "#/$defs/digest"},
    "step_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/step"}
    },
    "raw_content_serialized": {"const": false},
    "absolute_paths_serialized": {"const": false},
    "batch_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {"pattern": "[*?\\[\\]]"}
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_ordinal", "journal_id", "plan_digest", "target", "patch_kind"],
      "properties": {
        "sequence_ordinal": {"type": "integer", "minimum": 1, "maximum": 32},
        "journal_id": {"$ref": "#/$defs/id"},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "target": {"$ref": "#/$defs/target"},
        "patch_kind": {"enum": ["create_file", "append_suffix"]}
      }
    }
  }
}
