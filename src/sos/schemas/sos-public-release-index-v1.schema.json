{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sigmastratum/sigma-operator-stack/schemas/sos-public-release-index-v1.schema.json",
  "title": "SOS public release index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate", "contract", "platforms", "release_tag", "tree", "version"],
  "properties": {
    "candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract": {"const": "sos_public_release_index_v1"},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/platform"}
    },
    "release_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+a[0-9]+$", "maxLength": 40},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+a[0-9]+$", "maxLength": 32}
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "profile_id", "status", "system"],
      "properties": {
        "architecture": {"enum": ["x86_64", "arm64"]},
        "archive_filename": {"type": "string", "pattern": "^SOS-[A-Za-z0-9._-]+\\.(zip|tar\\.gz)$", "maxLength": 120},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "inner_manifest": {"const": "release-manifest.json"},
        "inner_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "invocation": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "launcher": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 80},
        "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "reason": {"type": "string", "pattern": "^SOS_[A-Z0-9_]+$", "maxLength": 96},
        "status": {"enum": ["admitted", "unsupported"]},
        "system": {"enum": ["linux", "windows", "darwin"]}
      },
      "oneOf": [
        {
          "properties": {"status": {"const": "admitted"}},
          "required": ["archive_filename", "archive_sha256", "archive_size", "inner_manifest", "inner_manifest_sha256", "invocation", "launcher"],
          "not": {"required": ["reason"]}
        },
        {
          "properties": {"status": {"const": "unsupported"}},
          "required": ["reason"],
          "not": {"anyOf": [{"required": ["archive_filename"]}, {"required": ["launcher"]}, {"required": ["invocation"]}]}
        }
      ]
    }
  }
}
