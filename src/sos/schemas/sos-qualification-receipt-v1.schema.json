{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sigmastratum.org/sos/sos-qualification-receipt-v1.schema.json",
  "title": "SOS Source-Bound Qualification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "repository_id", "source_tree_digest", "source_status_digest", "plan_digest", "admission_id", "claim_digest", "execution_result_digest", "executor_digest", "family_id", "command_id", "argv_digest", "isolation", "limits_digest", "status", "reasons", "exit_code", "output_digest", "output_bytes", "raw_output_serialized", "issued_at", "sequence_ordinal", "predecessor_receipt", "receipt_digest"],
  "properties": {
    "contract": {"const": "sos_qualification_receipt_v1"},
    "repository_id": {"$ref": "#/$defs/digest"},
    "source_tree_digest": {"$ref": "#/$defs/digest"},
    "source_status_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "admission_id": {"$ref": "#/$defs/digest"},
    "claim_digest": {"$ref": "#/$defs/digest"},
    "execution_result_digest": {"$ref": "#/$defs/digest"},
    "executor_digest": {"$ref": "#/$defs/digest"},
    "family_id": {"$ref": "#/$defs/token"},
    "command_id": {"$ref": "#/$defs/token"},
    "argv_digest": {"$ref": "#/$defs/digest"},
    "isolation": {"$ref": "#/$defs/token"},
    "limits_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["passed_local", "failed", "blocked", "unsupported", "not_verified", "skipped", "stale"]},
    "reasons": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/token"}},
    "exit_code": {"type": ["integer", "null"]},
    "output_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "output_bytes": {"type": "integer", "minimum": 0},
    "raw_output_serialized": {"const": false},
    "issued_at": {"type": "string", "format": "date-time"},
    "sequence_ordinal": {"type": "integer", "minimum": 1, "maximum": 10000},
    "predecessor_receipt": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"}
  }
}
