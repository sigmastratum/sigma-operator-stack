{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "authority_state",
    "current_work_path",
    "external_actions",
    "qualification_state",
    "safe_next_action"
  ],
  "properties": {
    "contract": {"type": "string", "const": "sos_fresh_codex_recovery_v1"},
    "authority_state": {"type": "string", "enum": ["accepted_local_weak_evidence"]},
    "current_work_path": {"type": "string", "enum": ["tasks/current.md"]},
    "external_actions": {"type": "string", "enum": ["owner_required"]},
    "qualification_state": {"type": "string", "enum": ["passed_local"]},
    "safe_next_action": {"type": "string", "enum": ["review-and-qualify"]}
  }
}
